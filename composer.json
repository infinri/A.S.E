{
    "name": "infinri/ase",
    "description": "Automated Security Evaluator -- Dependency-Track automation: syncs lockfile SBOMs and a declared-tech inventory, scores findings with CISA KEV + EPSS + CVSS, alerts per-team Slack channels on P0/P1.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "security",
        "vulnerability",
        "cve",
        "dependency-track",
        "sbom",
        "cyclonedx",
        "monitoring",
        "cli",
        "composer",
        "slack",
        "magento"
    ],
    "authors": [
        {
            "name": "Lucio Saldivar",
            "email": "lucio.saldivar@infinri.com"
        }
    ],
    "support": {
        "issues": "https://github.com/infinri/A.S.E/issues",
        "source": "https://github.com/infinri/A.S.E"
    },
    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "monolog/monolog": "^3.10",
        "symfony/yaml": "^8.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.1",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Ase\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ase\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/ase-sync",
        "bin/ase-alert"
    ],
    "scripts": {
        "test": "phpunit tests/Unit",
        "stan": "phpstan analyse --level=8 src"
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
